def poly_area(v):
    """Area of a planar 3-D polygon from its vertex list."""
    sx = sy = sz = 0.0
    n = len(v)
    for i in range(n):
        x1, y1, z1 = v[i]
        x2, y2, z2 = v[(i + 1) % n]
        sx += y1 * z2 - z1 * y2
        sy += z1 * x2 - x1 * z2
        sz += x1 * y2 - y1 * x2
    return 0.5 * math.sqrt(sx * sx + sy * sy + sz * sz)


class Surf(object):
    def __init__(self, name, stype, cons, zone, bc, bcobj, sun, wind, verts):
        self.name, self.stype, self.cons, self.zone = name, stype, cons, zone
        self.bc, self.bcobj, self.sun, self.wind, self.verts = bc, bcobj, sun, wind, verts
        self.window = None      # (name, verts) or None

    def text(self):
        s = ("BuildingSurface:Detailed,\n"
             "  %s,                    !- Name\n"
             "  %s,                    !- Surface Type\n"
             "  %s,                    !- Construction Name\n"
             "  %s,                    !- Zone Name\n"
             "  ,                      !- Space Name\n"
             "  %s,                    !- Outside Boundary Condition\n"
             "  %s,                    !- Outside Boundary Condition Object\n"
             "  %s,                    !- Sun Exposure\n"
             "  %s,                    !- Wind Exposure\n"
             "  ,                      !- View Factor to Ground\n"
             "%s\n" % (self.name, self.stype, self.cons, self.zone, self.bc, self.bcobj,
                       self.sun, self.wind, vtx(self.name, self.verts)))
        if self.window is not None:
            wn, wv = self.window
            s += ("FenestrationSurface:Detailed,\n"
                  "  %s,                    !- Name\n"
                  "  Window,                !- Surface Type\n"
                  "  C_WINDOW,              !- Construction Name\n"
                  "  %s,                    !- Building Surface Name\n"
                  "  ,                      !- Outside Boundary Condition Object\n"
                  "  ,                      !- View Factor to Ground\n"
                  "  ,                      !- Frame and Divider Name\n"
                  "  1,                     !- Multiplier\n"
                  "%s\n" % (wn, self.name, vtx(wn, wv)))
        return s


def _interior_construction(tag, r_resist, rho):
    """Both sides: `<tag>_A` = (resistive, capacitive) outside-to-inside, `<tag>_B` = reverse layer order."""
    return ("Material:NoMass,\n  %s_R,  !- Name\n  Rough,  !- Roughness\n  %.6f,  !- Thermal Resistance {m2-K/W}\n"
            "  0.90,  !- Thermal Absorptance\n  0.60,  !- Solar Absorptance\n  0.60;  !- Visible Absorptance\n\n"
            "Material,\n  %s_C,  !- Name\n  Rough,  !- Roughness\n  %.4f,  !- Thickness {m}\n"
            "  %.4f,  !- Conductivity {W/m-K}\n  %.4f,  !- Density {kg/m3}\n  %.1f;  !- Specific Heat {J/kg-K}\n\n"
            "Construction,\n  %s_A,  !- Name\n  %s_R,  !- Outside Layer\n  %s_C;  !- Layer 2\n\n"
            "Construction,\n  %s_B,  !- Name\n  %s_C,  !- Outside Layer\n  %s_R;  !- Layer 2\n\n"
            % (tag, r_resist, tag, MASS_D, MASS_K, rho, MASS_CP, tag, tag, tag, tag, tag, tag))


