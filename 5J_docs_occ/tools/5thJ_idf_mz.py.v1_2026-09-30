# --------------------------------------------------------------------------------------------
def build_mz(row, k, placement, infiltration_ach, north_axis_deg, collapse=False):
    lines = []

    def say(name, detail):
        ln = "PATCH %s OK %s" % (name, detail)
        print(ln)
        lines.append(ln)

    d = derive(row)
    cls = d["cls"]
    W, D = d["width"], d["depth"]
    n_st = d["n_storey"]
    if abs(n_st - round(n_st)) > 1e-9:
        raise MZError("n_Storey %r is not an integer in %s" % (n_st, d["code"]))
    n_st = int(round(n_st))
    spans = cls in ("SFH", "TH")
    if collapse:
        F, k, hz = 1, 1, d["height"]            # one full-height zone = the old box
        spans = True
    else:
        F, hz = n_st, d["h_room"]
        if spans and k != 1:
            raise MZError("%s: SFH/TH require k = 1, got %r" % (d["code"], k))
        if k < 1 or int(k) != k:
            raise MZError("k must be a positive integer, got %r" % (k,))
        k = int(k)
    H = F * hz
    n_dw = 1 if spans else F * k
    if sorted(placement) != list(range(n_dw)):
        raise MZError("placement keys %r != dwellings 0..%d" % (sorted(placement), n_dw - 1))
    sw = W / k                                   # dwelling width along E-W

    def zname(f, i):
        jj = 0 if spans else f * k + i
        return "Z_F%02d_D%02d" % (f, jj)

    # window fraction per facade = that 4J facade's fraction (design item 4)
    gross = {"N": W * d["height"], "S": W * d["height"], "E": D * d["height"], "W": D * d["height"]}
    fr = {key: (d["win_face"] / v if v > 0 else 0.0) for key, v in gross.items()}

    surfs = []
    zones = []
    pairs = 0

    def add_ext_wall(zone, tag, x0, y0, x1, y1, z0, z1, frac):
        v = [(x0, y0, z1), (x0, y0, z0), (x1, y1, z0), (x1, y1, z1)]
        s = Surf("W_%s_%s" % (tag, zone), "Wall", "C_WALL", zone, "Outdoors", "", "SunExposed", "WindExposed", v)
        if d["win_face"] > 0.0:
            s.window = ("F_%s_%s" % (tag, zone), inset_window(v, min(frac, WWR_CAP)))
        surfs.append(s)

    for f in range(F):
        z0, z1 = f * hz, (f + 1) * hz
        for i in range(k):
            zone = zname(f, i)
            zones.append({"zone": zone, "floor": f, "col": i, "dwelling": (0 if spans else f * k + i),
                          "floor_area": sw * D})
            x0, x1 = i * sw, (i + 1) * sw
            # exterior facades
            add_ext_wall(zone, "S", x0, 0.0, x1, 0.0, z0, z1, fr["S"])
            add_ext_wall(zone, "N", x1, D, x0, D, z0, z1, fr["N"])
            if i == 0:
                add_ext_wall(zone, "W", 0.0, D, 0.0, 0.0, z0, z1, fr["W"])
            if i == k - 1:
                add_ext_wall(zone, "E", W, 0.0, W, D, z0, z1, fr["E"])
            # party wall to the east neighbour (paired)
            if i < k - 1:
                a = zname(f, i)
                b = zname(f, i + 1)
                xs = x1
                # same vertex pattern as wall_vertices(xs, 0, xs, D, .) but between z0 and z1
                va = [(xs, 0.0, z1), (xs, 0.0, z0), (xs, D, z0), (xs, D, z1)]
                na, nb = "PW_%s_E" % a, "PW_%s_W" % b
                surfs.append(Surf(na, "Wall", "C_PARTY_A", a, "Surface", nb, "NoSun", "NoWind", va))
                surfs.append(Surf(nb, "Wall", "C_PARTY_B", b, "Surface", na, "NoSun", "NoWind", va[::-1]))
                pairs += 1
            # roof or ceiling
            up = [(x0, D, z1), (x0, 0.0, z1), (x1, 0.0, z1), (x1, D, z1)]
            if f == F - 1:
                surfs.append(Surf("S_ROOF_%s" % zone, "Roof", "C_ROOF", zone, "Outdoors", "", "SunExposed",
                                  "WindExposed", up))
            else:
                upper = zname(f + 1, i)
                nc, nf = "IC_%s" % zone, "IF_%s" % upper
                if upper == zone:               # cannot happen (different floors have different names)
                    raise MZError("zone name collision %s" % zone)
                surfs.append(Surf(nc, "Ceiling", "C_IFLOOR_A", zone, "Surface", nf, "NoSun", "NoWind", up))
                surfs.append(Surf(nf, "Floor", "C_IFLOOR_B", upper, "Surface", nc, "NoSun", "NoWind", up[::-1]))
                pairs += 1
            # ground floor
            if f == 0:
                surfs.append(Surf("S_FLOOR_%s" % zone, "Floor", "C_FLOOR", zone, "Ground", "", "NoSun", "NoWind",
                                  [(x0, 0.0, z0), (x0, D, z0), (x1, D, z0), (x1, 0.0, z0)]))

    # ---- areas (computed from the vertices actually written) --------------------------------
    def area_where(pred):
        return sum(poly_area(s.verts) for s in surfs if pred(s))

    a_win = sum(poly_area(s.window[1]) for s in surfs if s.window)
    a_wall_gross = area_where(lambda s: s.stype == "Wall" and s.bc == "Outdoors")
    a_wall_net = a_wall_gross - a_win
    a_roof = area_where(lambda s: s.stype == "Roof")
    a_ground = area_where(lambda s: s.bc == "Ground")
    a_floor_zones = area_where(lambda s: s.stype == "Floor")
    a_inter = area_where(lambda s: s.bc == "Surface") / 2.0     # each pair counted once
    a_opaque = a_wall_net + a_roof + a_ground + a_inter
    c_total = C_M_J_M2K * d["a_ref"]
    rho = c_total / (a_opaque * MASS_D * MASS_CP)
    cap_model = rho * MASS_D * MASS_CP * a_opaque

    say("mz_geometry", "floors=%d k=%d zones=%d dwellings=%d collapse=%s plate=%.4f x %.4f h_floor=%.4f"
        % (F, k, len(zones), n_dw, collapse, W, D, hz))
    say("mz_areas", "zone_floor_sum=%.4f A_C_Ref=%.4f ext_wall_net=%.4f a_wall_box=%.4f roof=%.4f ground=%.4f "
        "a_plate=%.4f interzone_pair_area=%.4f" % (a_floor_zones, d["a_ref"], a_wall_net, d["a_wall_box"], a_roof,
                                                   a_ground, d["a_plate"], a_inter))
    say("mz_windows", "glazing=%.4f win_total=%.4f fractions N=%.4f S=%.4f E=%.4f W=%.4f"
        % (a_win, d["win_total"], fr["N"], fr["S"], fr["E"], fr["W"]))
    say("mz_mass", "capacity=%.1f J/K c_m*A_C_Ref=%.1f J/K rho=%.4f kg/m3 opaque_area_pairs_once=%.4f"
        % (cap_model, c_total, rho, a_opaque))
    say("mz_pairs", "pairs=%d interzone_surfaces=%d" % (pairs, sum(1 for s in surfs if s.bc == "Surface")))
    # internal consistency of the pairs, straight from the surface objects
    byname = {s.name: s for s in surfs}
    for s in surfs:
        if s.bc == "Surface":
            p = byname.get(s.bcobj)
            if p is None or p.bcobj != s.name or p.verts != s.verts[::-1] or p.zone == s.zone:
                raise MZError("pair broken at %s" % s.name)

    # ---- constructions -------------------------------------------------------------------------
    c_wall, _, _ = opaque_construction("C_WALL", d["u_wall"] + d["dub"], "wall", rho)
    c_roof, _, _ = opaque_construction("C_ROOF", d["u_roof"] + d["dub"], "roof", rho)
    c_floor, _, _ = opaque_construction("C_FLOOR", d["u_floor"] + d["dub"], "floor", rho)

    name = d["code"].replace(".", "_")
    L = []
    L.append("!- 5J multi-zone IDF (D2-8), generated by tools/5thJ_idf_mz.py")
    L.append("!- Archetype   : %s   (TABULA physics of the 4J Step 8 box, derive() imported unchanged)" % d["code"])
    L.append("!- Layout      : k = %d dwellings per floor, floors = %d, zones = %d, dwellings = %d, collapse = %s"
             % (k, F, len(zones), n_dw, collapse))
    L.append("!- ASSUMED     : interior floor resistive layer R = %.2f m2K/W, party wall resistive layer R = %.2f m2K/W"
             " (capacitive layer R 0.01 and surface films come on top; author may change)" % (R_IFLOOR, R_PARTY))
    L.append("!- Mass        : total capacity c_m x A_C_Ref conserved, per m2 over ALL opaque surfaces"
             " (exterior + interior, each interior pair counted once)")
    L.append("!- Zoning      : one IdealLoads per zone, DualSetpoint %.1f/%.1f C, E_PHI_INT 0 W" % (HEAT_SP_C, COOL_SP_C))
    L.append("")
    L.append("Version, %s;" % EPLUS_VERSION)
    L.append("")
    L.append("Building,\n  %s,\n  %.4f,\n  City,\n  0.04,\n  0.4,\n  FullExterior,\n  25,\n  6;" % (name, north_axis_deg))
    L.append("")
    L.append("Timestep, 6;")
    L.append("GlobalGeometryRules, UpperLeftCorner, CounterClockWise, World;")
    L.append("SimulationControl, No, No, No, No, Yes, No, 1;")
    L.append("ShadowCalculation, PolygonClipping, Periodic, 20;")
    L.append("")
    L.append("ScheduleTypeLimits, Frac, 0.0, 1.0, Continuous;")
    L.append("ScheduleTypeLimits, Temp, -60.0, 200.0, Continuous, Temperature;")
    L.append("ScheduleTypeLimits, CtrlType, 0, 4, Discrete, Control;")
    L.append("Schedule:Constant, SCH_ALWAYS_ON, Frac, 1.0;")
    L.append("Schedule:Constant, SCH_HEAT_SP, Temp, %.1f;" % HEAT_SP_C)
    L.append("Schedule:Constant, SCH_COOL_SP, Temp, %.1f;" % COOL_SP_C)
    L.append("Schedule:Constant, T_TYPE, CtrlType, 4;")
    L.append("ThermostatSetpoint:DualSetpoint, T_SP, SCH_HEAT_SP, SCH_COOL_SP;")
    L.append("")
    L.append(c_wall)
    L.append(c_roof)
    L.append(c_floor)
    if not collapse and (F > 1):
        L.append(_interior_construction("C_IFLOOR", R_IFLOOR, rho))
    if not collapse and k > 1:
        L.append(_interior_construction("C_PARTY", R_PARTY, rho))
    L.append("WindowMaterial:SimpleGlazingSystem,\n  G_WINDOW,  !- Name\n  %.4f,  !- U-Factor {W/m2-K}\n"
             "  %.4f;  !- Solar Heat Gain Coefficient\n" % (d["u_win"], SHGC))
    L.append("Construction, C_WINDOW, G_WINDOW;")
    L.append("")
    for z in zones:
        L.append(_zone_text(z["zone"]))
    for s in surfs:
        L.append(s.text())
    for z in zones:
        L.append(_phi_zero_text(z["zone"]))
        L.append(_infil_text(z["zone"], infiltration_ach))
        L.append(_hvac_text(z["zone"]))
    L.append("RunPeriod,\n  ANNUAL,  !- Name\n  1, 1, ,  !- Begin month, day, year\n"
             "  12, 31, ,  !- End month, day, year\n  Sunday,  !- Day of Week for Start Day\n"
             "  No, No, No, Yes, Yes;  !- Holidays, DST, rain, snow\n")

    # ---- people and appliances ---------------------------------------------------------------
    by_dw = {}
    for z in zones:
        by_dw.setdefault(z["dwelling"], []).append(z)
    L.append("Schedule:Constant, Activity_Level, , %d;\n" % ACTIVITY_W)
    done_sched = set()
    p_txt, a_txt = [], []
    n_people_tot = 0.0
    design_tot = 0.0
    for j in sorted(by_dw):
        hh = placement[j]
        hid = hh["hid"]
        tag = "HH_%s_%s" % (hh.get("fold", "es"), hid)
        if tag not in done_sched:
            pv = _read_series(hh["presence_csv"])
            av = _read_series(hh["appliance_csv"])
            p_txt.append(_sched_file(tag + "_Presence", hh["presence_csv"], 8760))
            a_txt.append(_sched_file(tag + "_Appliance", hh["appliance_csv"], 8760))
            done_sched.add(tag)
        dw_area = sum(z["floor_area"] for z in by_dw[j])
        for z in by_dw[j]:
            share = z["floor_area"] / dw_area
            npeople = float(hh["n_members"]) * share
            lvl = float(hh["appliance_peak_w"]) * share
            n_people_tot += npeople
            design_tot += lvl
            p_txt.append("People,\n  PE_%s,  !- Name\n  %s,  !- Zone or ZoneList Name\n"
                         "  %s_Presence,  !- Number of People Schedule Name\n  People,  !- Number of People Calculation Method\n"
                         "  %.6f,  !- Number of People\n  ,  !- People per Zone Floor Area\n"
                         "  ,  !- Zone Floor Area per Person\n  0.3,  !- Fraction Radiant\n"
                         "  ,  !- Sensible Heat Fraction\n  Activity_Level;  !- Activity Level Schedule Name\n"
                         % (z["zone"], z["zone"], tag, npeople))
            a_txt.append("ElectricEquipment,\n  EQ_%s,  !- Name\n  %s,  !- Zone or ZoneList Name\n"
                         "  %s_Appliance,  !- Schedule Name\n  EquipmentLevel,  !- Design Level Calculation Method\n"
                         "  %.4f,  !- Design Level {W}\n  ,  !- Watts per Zone Floor Area\n  ,  !- Watts per Person\n"
                         "  0.0,  !- Fraction Latent\n  1.0,  !- Fraction Radiant\n  0.0;  !- Fraction Lost\n"
                         % (z["zone"], z["zone"], tag, lvl))
    L.append("\n".join(p_txt))
    say("mz_people", "zones=%d dwellings=%d total_people=%.4f activity=%d W radiant 0.3"
        % (len(zones), len(by_dw), n_people_tot, ACTIVITY_W))
    L.append("\n".join(a_txt))
    say("mz_appliances", "zones=%d total_design_level=%.4f W (split by floor-area share for SFH/TH), radiant 1.0"
        % (len(zones), design_tot))

    L.append("")
    for v in OUTPUT_VARIABLES:
        L.append("Output:Variable,*,%s,Hourly;" % v)
    for mname in OUTPUT_METERS:
        L.append("Output:Meter,%s,Hourly;" % mname)
    L.append("Output:VariableDictionary, Regular;")
    L.append("OutputControl:Table:Style, CommaAndHTML;")
    L.append("Output:Table:SummaryReports, AllSummary;")
    L.append("")
    say("mz_outputs", "variables=%d meters=%d (hourly, * key) + VariableDictionary + AllSummary; "
        "no Lights object written (none in the pilot inputs or 5thJ_idf.py)"
        % (len(OUTPUT_VARIABLES), len(OUTPUT_METERS)))

    meta = {
        "row_code": d["code"], "cls": cls, "k": k, "floors": F, "zones": [z["zone"] for z in zones],
        "zone_floor_areas": {z["zone"]: z["floor_area"] for z in zones},
        "zone_dwelling": {z["zone"]: z["dwelling"] for z in zones},
        "n_dwellings": n_dw, "collapse": collapse, "infiltration_ach": infiltration_ach,
        "north_axis_deg": north_axis_deg, "rho": rho, "pairs": pairs,
        "areas": {"zone_floor_sum": a_floor_zones, "ext_wall_net": a_wall_net, "roof": a_roof, "ground": a_ground,
                  "glazing": a_win, "interzone_pairs_once": a_inter, "capacity_j_per_k": cap_model},
        "derive": {k_: d[k_] for k_ in ("a_ref", "a_plate", "a_wall_box", "win_total", "width", "depth", "height",
                                        "h_room", "n_storey", "u_wall", "u_roof", "u_floor", "u_win", "dub",
                                        "aspect_source", "aspect_fallback")},
        "patch_lines": lines,
    }
    return "\n".join(L) + "\n", meta


# --------------------------------------------------------------------------------------------
# Gate: parse the SAVED IDF text (independent of the builder's own bookkeeping)
# --------------------------------------------------------------------------------------------
def _objects(text, keyword):
    """Field lists of every object whose keyword starts a line (comments stripped)."""
    out = []
    for m in re.finditer(r"^%s,(.*?);" % re.escape(keyword), text, re.S | re.M):
        body = "\n".join(ln.split("!")[0] for ln in m.group(1).splitlines())
        out.append([f.strip() for f in body.replace("\n", " ").split(",")])
    return out


def _parse_surfaces(text):
    res = []
    for f in _objects(text, "BuildingSurface:Detailed"):
        n = int(f[10])
        nums = [float(x) for x in f[11:11 + 3 * n]]
        if len(nums) != 3 * n:
            raise MZError("vertex count mismatch in %s" % f[0])
        verts = [tuple(nums[3 * i:3 * i + 3]) for i in range(n)]
        res.append({"name": f[0], "type": f[1], "cons": f[2], "zone": f[3], "bc": f[5], "bcobj": f[6],
                    "verts": verts, "area": poly_area(verts)})
    return res


def _parse_windows(text):
    res = []
    for f in _objects(text, "FenestrationSurface:Detailed"):
        n = int(f[8])
        nums = [float(x) for x in f[9:9 + 3 * n]]
        verts = [tuple(nums[3 * i:3 * i + 3]) for i in range(n)]
        res.append({"name": f[0], "host": f[3], "verts": verts, "area": poly_area(verts)})
    return res


def check_area_gates(idf_text, row, tol=1e-4):
    """Returns list of (status, gate, detail). All six gates read only the IDF text and `derive(row)`."""
    d = derive(row)
    S = _parse_surfaces(idf_text)
    Wn = _parse_windows(idf_text)
    mats = {f[0]: f for f in _objects(idf_text, "Material")}
    cons = {f[0]: f[1:] for f in _objects(idf_text, "Construction")}
    out = []

    def rel(a, b):
        return abs(a - b) / abs(b) if b else abs(a)

    def gate(name, a, b):
        ok = rel(a, b) <= tol
        out.append(("PASS" if ok else "FAIL", name, "got %.4f expected %.4f rel %.3g" % (a, b, rel(a, b))))

    floor_sum = sum(s["area"] for s in S if s["type"].lower() == "floor")
    gate("zone_floor_area_sum_eq_A_C_Ref", floor_sum, d["a_ref"])
    a_wall = sum(s["area"] for s in S if s["type"].lower() == "wall" and s["bc"].lower() == "outdoors")
    a_win = sum(w["area"] for w in Wn)
    gate("exterior_opaque_wall_eq_a_wall_box", a_wall - a_win, d["a_wall_box"])
    gate("glazing_eq_win_total", a_win, d["win_total"])
    gate("roof_eq_a_plate", sum(s["area"] for s in S if s["type"].lower() == "roof"), d["a_plate"])
    gate("ground_eq_a_plate", sum(s["area"] for s in S if s["bc"].lower() == "ground"), d["a_plate"])
    # capacity: areal capacity of each surface's capacitive layer, interzone surfaces counted half (pair once)
    cap = 0.0
    for s in S:
        layers = cons.get(s["cons"])
        if layers is None:
            out.append(("FAIL", "capacity", "construction %s missing" % s["cons"]))
            return out
        c_layers = [m for m in layers if m in mats]
        if len(c_layers) != 1:
            out.append(("FAIL", "capacity", "construction %s has %d capacitive layers" % (s["cons"], len(c_layers))))
            return out
        m = mats[c_layers[0]]                   # name, rough, thick, cond, dens, cp
        areal = float(m[2]) * float(m[4]) * float(m[5])
        w = 0.5 if s["bc"].lower() == "surface" else 1.0
        a = s["area"] - (sum(x["area"] for x in Wn if x["host"] == s["name"]))
        cap += areal * a * w
    gate("total_capacity_eq_c_m_x_A_C_Ref", cap, C_M_J_M2K * d["a_ref"])
    # pairing
    byname = {s["name"]: s for s in S}
    bad = []
    npairs = 0
    for s in S:
        if s["bc"].lower() != "surface":
            continue
        p = byname.get(s["bcobj"])
        if p is None:
            bad.append("%s: partner %s missing" % (s["name"], s["bcobj"]))
            continue
        if p["bcobj"] != s["name"]:
            bad.append("%s: partner does not name it back" % s["name"])
        if rel(p["area"], s["area"]) > tol:
            bad.append("%s: area %.4f vs %.4f" % (s["name"], s["area"], p["area"]))
        if p["verts"] != s["verts"][::-1]:
            bad.append("%s: vertex order not reversed" % s["name"])
        if p["zone"] == s["zone"]:
            bad.append("%s: partner in same zone" % s["name"])
        npairs += 1
    out.append(("PASS" if not bad else "FAIL", "interzone_surfaces_paired",
                "interzone surfaces=%d problems=%d %s" % (npairs, len(bad), "; ".join(bad[:3]))))
    return out


